# Webhook n8n — workflow "Medina Fusion - Commande Traiteur"
VITE_WEBHOOK_COMMANDE_URL=https://medina93.app.n8n.cloud/webhook/commande-traiteur

# Webhook n8n dédié à la dégustation gratuite (optionnel).
# Si vide, les demandes de dégustation partent sur VITE_WEBHOOK_COMMANDE_URL avec "type": "degustation".
VITE_WEBHOOK_DEGUSTATION_URL=

# Délai max d'attente du webhook avant fallback mailto (ms)
VITE_WEBHOOK_TIMEOUT_MS=10000

# Espace administrateur (Supabase → Project Settings → API)
# Sans ces deux valeurs, /admin s'ouvre en mode démo (données fictives).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
